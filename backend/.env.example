# ==========================================================
# AlienOS Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ==========================================================

# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://alienos:alienos@localhost:5432/alienos_dev?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# Frontend URL — used to build links inside verification/reset emails
FRONTEND_URL=http://localhost:5173

# Email (Phase 10: EmailService logs to console when SMTP_HOST is unset —
# safe default for local dev; set these to send real emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AlienOS <no-reply@alienos.dev>"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Storage (local now, S3-ready later)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# AI providers
# Gemini is the PRIMARY/default provider for AlienOS. Set GEMINI_API_KEY to
# enable it — get one at https://aistudio.google.com/apikey. AI_GEMINI_API_KEY
# is accepted too, as a fallback, for anyone who set that up before Phase 2.
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash

# OpenAI and Anthropic are optional secondary providers, selectable per-user
# under Settings > AI. Leave blank to keep them unavailable — the app falls
# back gracefully (to Gemini, then to the local "demo" provider) if a user's
# preferred provider isn't configured.
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1-mini
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (self-hosted, optional) — text chat only, no tool-calling support yet.
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.1

# Which provider to fall back to when a user's selected provider isn't
# configured. Defaults to "gemini".
AI_DEFAULT_PROVIDER=gemini

# AI request tuning
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_TOOL_ITERATIONS=4
AI_MAX_HISTORY_MESSAGES=24

# Logging
LOG_LEVEL=debug
