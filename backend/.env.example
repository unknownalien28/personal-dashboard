# ==========================================================
# AlienOS Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ==========================================================

# App
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://alienos:alienos@localhost:5432/alienos_dev?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d
BCRYPT_SALT_ROUNDS=12
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# Frontend URL — used to build links inside verification/reset emails
FRONTEND_URL=http://localhost:5173

# Email (Phase 10: EmailService logs to console when SMTP_HOST is unset —
# safe default for local dev; set these to send real emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AlienOS <no-reply@alienos.dev>"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Storage (local now, S3-ready later)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# AI (Gemini - AlienOS's only AI provider)
# Set GEMINI_API_KEY to enable AI chat — get one at
# https://aistudio.google.com/apikey. AI_GEMINI_API_KEY is accepted too, as a
# fallback, for anyone who set that up before this was simplified to a single
# provider. If neither is set, AI chat returns a clear "not configured" error
# instead of silently failing or fabricating a response.
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.6-flash

# AI request tuning
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_TOOL_ITERATIONS=4
AI_MAX_HISTORY_MESSAGES=24

# Logging
LOG_LEVEL=debug
